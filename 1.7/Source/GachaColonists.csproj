<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>embedded</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../Assemblies/</OutputPath>
  </PropertyGroup>

  <!-- Default to the standard Steam location on macOS; callers can override it. -->
  <PropertyGroup>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and Exists('$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorld.app')">$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld</RimWorldDir>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' and Exists('$(RimWorldDir)/RimWorld.app/Contents/MacOS/Assembly-CSharp.dll')">$(RimWorldDir)/RimWorld.app/Contents/MacOS</RimWorldManagedDir>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' and Exists('$(RimWorldDir)/RimWorld_Data/Managed/Assembly-CSharp.dll')">$(RimWorldDir)/RimWorld_Data/Managed</RimWorldManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldManagedDir)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldManagedDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRimWorldReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldManagedDir)' == '' or !Exists('$(RimWorldManagedDir)/Assembly-CSharp.dll')" Text="RimWorld 1.7 libraries were not found. Set RimWorldDir to the game folder or RimWorldManagedDir to its library folder." />
    <Error Condition="!Exists('$(RimWorldManagedDir)/Waylith.dll') or !Exists('$(RimWorldManagedDir)/UnityStubs.dll')" Text="Waylith.dll or UnityStubs.dll is missing from $(RimWorldManagedDir)." />
  </Target>
</Project>
